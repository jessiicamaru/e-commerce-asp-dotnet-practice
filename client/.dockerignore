# Docker does not read .gitignore (see server/.dockerignore). The build context is client/.

# --- secrets first ---
**/.env
**/.env.*

# --- installed and built on the host: wrong platform, large, and rebuilt inside ---
# `**/` because client/ is a workspace (specs/135): each app and package can have its own.
**/node_modules/
**/dist/
**/coverage/
*.log

# --- not needed to build the bundle ---
.git/
Dockerfile
.dockerignore
