{
  "name": "ecommerce-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ecommerce/storefront",
    "dev:back-office": "npm run dev -w @ecommerce/back-office",
    "build": "tsc -b && npm run build -w @ecommerce/storefront && npm run build -w @ecommerce/back-office",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run preview -w @ecommerce/storefront",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
