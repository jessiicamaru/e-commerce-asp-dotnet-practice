# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=e-commerce

IDENTITY_DB_PORT=5435

INVENTORY_DB_PORT=5437
INVENTORY_RESERVATION_TTL_MINUTES=15
INVENTORY_SWEEP_INTERVAL_SECONDS=30

# pgAdmin Configuration
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=your_pgadmin_password

# JWT Configuration
JWT_SECRET=your_generated_openssl_secret_here

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_rabbitmq_password

# Bootstrap Administrator (seeded on Identity startup, only while no admin exists yet)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=your_admin_password_min_8_chars
