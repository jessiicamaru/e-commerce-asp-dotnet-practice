# Copy to .env and fill in. `.env` is gitignored and must stay that way.
#
# PRECEDENCE: a real environment variable beats this file. The file only fills in
# what the environment has not set. (It used to be the other way round, which is
# why `PAYMENT_OUTCOME=Reject dotnet run ...` used to be silently ignored.)

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=e-commerce

# Where the databases are. `localhost` for docker compose + start-dev.sh; the
# compose overlay overrides it per service with a container name.
DB_HOST=localhost

# Host ports, one per service database. These are what docker-compose.yml
# publishes and what each service connects to by default.
IDENTITY_DB_PORT=5435
CATALOG_DB_PORT=5433
ORDER_DB_PORT=5434
ORCHESTRATOR_DB_PORT=5436
INVENTORY_DB_PORT=5437
PAYMENT_DB_PORT=5438
ACTIVITY_DB_PORT=5440

# Database names. Defaults in each Program.cs match these; set them only to differ.
# IDENTITY_DB_NAME=ecommerce_identity_db
# CATALOG_DB_NAME=ecommerce_catalog_db
# ORDER_DB_NAME=ecommerce_order_db
# SAGA_DB_NAME=ecommerce_saga_db          # note: SAGA_, not ORCHESTRATOR_
# INVENTORY_DB_NAME=ecommerce_inventory_db
# PAYMENT_DB_NAME=ecommerce_payment_db

INVENTORY_RESERVATION_TTL_MINUTES=15
# How long the saga waits for Payment once stock is reserved (specs/053). Must be shorter than the
# hold above by more than one sweep (30 s), or the orchestrator refuses to start.
ORCHESTRATOR_PAYMENT_TIMEOUT_SECONDS=600
INVENTORY_SWEEP_INTERVAL_SECONDS=30

PAYMENT_OUTCOME=Approve

# What each service listens on. Leave unset for start-dev.sh: each service then
# keeps its own pinned port (5000, 5056-5061). The compose overlay sets
# http://+:8080 for every service and maps those ports on the host instead.
# ASPNETCORE_URLS=

# Whether a service applies its own EF migrations at startup. Leave unset here:
# start-dev.sh runs `dotnet ef database update` from the host. The compose overlay
# sets it to true, because a runtime image has neither the SDK nor the source.
# RUN_MIGRATIONS_ON_STARTUP=false

# pgAdmin Configuration
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=your_pgadmin_password

# JWT Configuration
# Must be identical for every service: Identity signs with it, everyone else
# validates with it. A mismatch produces a 401 that looks like an authorization bug.
JWT_SECRET=your_generated_openssl_secret_here

# RabbitMQ Configuration
# The services read RABBITMQ_PASS; docker-compose.yml reads RABBITMQ_PASSWORD.
# A non-default password needs BOTH set to the same value.
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_PASS=your_rabbitmq_password

# Bootstrap Administrator (seeded on Identity startup, only while no admin exists yet)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=your_admin_password_min_8_chars

# --- Observability (feature 013) -------------------------------------------------------------
# Seq's first admin password. REQUIRED by docker-compose.yml; Seq will not start without one.
SEQ_ADMIN_PASSWORD=your_seq_admin_password
# Where services on the host (start-dev) send logs and traces. Leave unset to export nothing.
# Containers get http://seq:5341/ingest/otlp from docker-compose.app.yml instead.
OTLP_ENDPOINT=http://localhost:5341/ingest/otlp

# Email (specs/060). Identity sends through SMTP; by default to Mailpit from docker-compose.yml
# (inbox at http://localhost:8025), so a development stack never reaches a real inbox.
SMTP_HOST=localhost
SMTP_PORT=1025
STOREFRONT_URL=http://localhost:5173

# Product images in object storage (specs/079). docker-compose.yml runs SeaweedFS with this one identity;
# the Catalog container signs with it. Any values - they only have to agree with each other.
SEAWEEDFS_ACCESS_KEY=your_seaweedfs_access_key
SEAWEEDFS_SECRET_KEY=your_seaweedfs_secret_key
