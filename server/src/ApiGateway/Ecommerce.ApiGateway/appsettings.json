          "Path": "/api/cart/{**catch-all}"
        }
      },
      "cart-root-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart"
        }
      },
      "cart-health-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      }
