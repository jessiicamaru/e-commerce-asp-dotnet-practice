{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "sign-in",
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "auth-register-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "sign-in",
        "Match": {
          "Path": "/api/auth/register"
        }
      },
      "auth-register-seller-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "sign-in",
        "Match": {
          "Path": "/api/auth/register-seller"
        }
      },
      "auth-reset-password-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "sign-in",
        "Match": {
          "Path": "/api/auth/reset-password"
        }
      },
      "auth-forgot-password-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "email",
        "Match": {
          "Path": "/api/auth/forgot-password"
        }
      },
      "auth-refresh-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "session",
        "Match": {
          "Path": "/api/auth/refresh"
        }
      },
      "auth-confirm-email-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "sign-in",
        "Match": {
          "Path": "/api/auth/confirm-email"
        }
      },
      "auth-resend-confirmation-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "email",
        "Match": {
          "Path": "/api/auth/resend-confirmation"
        }
      },
      "auth-change-password-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "sign-in",
        "Match": {
          "Path": "/api/auth/me/password"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "addresses-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/addresses/{**catch-all}"
        }
      },
      "addresses-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/addresses"
        }
      },
      "sellers-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/sellers/{**catch-all}"
        }
      },
      "sellers-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/sellers"
        }
      },
      "shop-applications-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/shop-applications/{**catch-all}"
        }
      },
      "shop-applications-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/shop-applications"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "users-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users"
        }
      },
      "identity-health-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "catalog-products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "catalog-reviews-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "catalog-reviews-root-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/reviews"
        }
      },
      "catalog-questions-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/questions/{**catch-all}"
        }
      },
      "catalog-questions-root-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/questions"
        }
      },
      "catalog-health-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "voucher-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/vouchers/{**catch-all}"
        }
      },
      "order-health-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "inventory-stock-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/stock/{**catch-all}"
        }
      },
      "inventory-reservations-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "orchestrator-health-route": {
