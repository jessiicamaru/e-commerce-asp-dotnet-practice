        "Match": {
          "Path": "/api/orchestrator/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "inventory-health-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "audit-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        }
      },
      "audit-root-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/audit"
        }
      },
      "notifications-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-root-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "activity-health-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/activity/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "payment-health-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "cart-root-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart"
        }
      },
      "cart-health-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5056/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5057/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5059/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5060/"
          }
        }
      },
      "orchestrator-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5058/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5061/"
          }
        }
      },
      "activity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5063/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
