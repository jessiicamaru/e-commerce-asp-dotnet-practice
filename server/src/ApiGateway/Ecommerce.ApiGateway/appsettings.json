      "audit-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        }
      },
      "audit-root-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/audit"
        }
      },
      "notifications-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-root-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "activity-health-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/activity/health"
        },
        "Transforms": [
          {
            "PathPattern": "/health"
          }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
