# The production stack's settings (specs/141). Copy to a file OUTSIDE the repository - /etc/ecommerce/.env, readable by
# root only - and pass it with --env-file. Every secret below is generated, never invented, and never committed.

# --- what runs ------------------------------------------------------------------------------------------------------
# An immutable release (specs/008). Also settable per command: RELEASE=sha-1a2b3c4 docker compose ...
RELEASE=sha-0000000
# IMAGE_PREFIX=ghcr.io/jessiicamaru/ecommerce

# --- where --------------------------------------------------------------------------------------------------------
# Two hosts (ADR-003), both pointing at this server. Cookies are per host, so they must differ - not only by port.
SHOP_DOMAIN=shop.example.com
PORTAL_DOMAIN=portal.shop.example.com
# On a laptop: SHOP_DOMAIN=shop.localhost and PORTAL_DOMAIN=portal.shop.localhost (Caddy's own CA).

# --- databases and the broker ---------------------------------------------------------------------------------------
DB_USER=ecommerce
DB_PASSWORD=                  # openssl rand -base64 32
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=            # openssl rand -base64 32

# --- signing and secrets --------------------------------------------------------------------------------------------
JWT_SECRET=                   # openssl rand -base64 48   (at least 32 bytes)
TWO_FACTOR_KEY=               # openssl rand -base64 32   (exactly 32 bytes; losing it loses every enrolled authenticator)
SEAWEEDFS_ACCESS_KEY=         # openssl rand -hex 16
SEAWEEDFS_SECRET_KEY=         # openssl rand -base64 32
SEQ_ADMIN_PASSWORD=           # openssl rand -base64 24   (Seq asks for a new one at the first sign-in)

# --- the first administrator (specs/043) - seeded once, while no administrator exists ----------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=               # sign in, then set up two-factor sign-in on the storefront before the back office

# --- email (specs/141): a real mail server, signed in to over STARTTLS --------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=Shop <no-reply@shop.example.com>

# --- payments (specs/143) ----------------------------------------------------------------------------------------------
# Stub until a VNPay merchant is registered; then VnPay with the merchant's own codes from VNPay's portal, and the IPN
# address https://<SHOP_DOMAIN>/api/payments/vnpay/ipn registered there. VNPAY_LIVE=true only with the production gateway.
PAYMENT_PROVIDER=Stub
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_LIVE=false

# --- only to verify the stack on a laptop ------------------------------------------------------------------------------
# COMPOSE_PROFILES=mail-catcher      # and SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_TLS=false, no username or password

# pgAdmin is never started in production (profile "tools"); compose still reads these.
PGADMIN_EMAIL=nobody@example.com
PGADMIN_PASSWORD=unused
